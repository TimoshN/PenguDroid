// YCbCr 4:2:0 (two planes) -> RGBA8, one invocation per output pixel.
// Compiled into video_convert.spv.h; regenerate with tools/build-video-bridge.sh --shader.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D luma;
layout(set = 0, binding = 1) uniform sampler2D chroma;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D target;
layout(push_constant) uniform Parameters {
    vec4 range;  // luma offset, luma scale, chroma scale, chroma zero
    vec4 matrix; // Cr->R, Cb->G, Cr->G, Cb->B
} parameters;

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (any(greaterThanEqual(at, size))) return;
    float y = (texelFetch(luma, at, 0).r - parameters.range.x) * parameters.range.y;
    // The decode image is the coded size; never filter in padding texels past
    // the visible chroma rectangle.
    vec2 visible = max(vec2((size + 1) / 2) - 0.5, vec2(0.5));
    vec2 texel = min((vec2(at) + 0.5) * 0.5, visible);
    vec2 cbcr = (textureLod(chroma, texel / vec2(textureSize(chroma, 0)), 0.0).rg - parameters.range.w) * parameters.range.z;
    vec3 rgb = vec3(y + parameters.matrix.x * cbcr.y,
                    y - parameters.matrix.y * cbcr.x - parameters.matrix.z * cbcr.y,
                    y + parameters.matrix.w * cbcr.x);
    imageStore(target, at, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
